# Core
BACKEND_DATABASE_URL=postgresql+psycopg://app:devpass@localhost:5432/appdb
RUN_DB_MIGRATIONS=1
AGENT_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=
LANGSMITH_API_KEY=
AGENT_OPENAI_MAX_RETRIES=3
AGENT_CHECKPOINTER=memory
FUN_AGENT_SPICE=0.05

# Auth
AUTH_DISABLED=1
DEV_FAKE_OWNER_ID=owner-dev-1
NEXTAUTH_SECRET=change-me-32-bytes
OWNER_EMAIL=owner@example.com
DEV_LOGIN_CODE=demo-pass-123

# API / UI
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEV_ERROR_DETAILS=0
DEBUG_ENDPOINTS=0
CHAT_THREAD_TTL_DAYS=30

# Rate limiting (optional Redis)
RATE_LIMIT_CHAT_PER_MIN=15
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# SMTP (optional)
MAIL_FROM="Studio <you@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_STARTTLS=true

# Holidays
HOLIDAYS_DEFAULT_COUNTRY=CA
HOLIDAYS_DEFAULT_REGION=CA-NB

# Agent safety
ALLOW_AGENT_DIRECT_EMAIL=0
DEV_DEBUG_TOKEN=changeme-debug-token

# Observability (optional)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=aieng-3-dev
