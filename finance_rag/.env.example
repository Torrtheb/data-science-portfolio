### Backend (.env.example)

# === Core LLM / RAG ===
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Vector store (Qdrant) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY= # optional for local docker
QDRANT_COLLECTION=finance_docs
DOCS_DIR=./data/raw

# === Market data APIs ===
FINNHUB_API_KEY=your-finnhub-key
TWELVEDATA_API_KEY=your-twelvedata-key
FINNHUB_RPS=20
FINNHUB_PERIOD=1

# === HTTP / CORS ===
BACKEND_ORIGIN=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
MAX_BODY_BYTES=5000000

# === Rate limiting ===
RATE_LIMIT_RPS=3.0
RATE_LIMIT_BURST=10
REDIS_URL= # set to redis://localhost:6379 to enable shared limiter
RATE_LIMIT_NAMESPACE=finassist

# === Sessions / auth ===
SESSION_TOKEN_SECRET=change-me-strong-random
SESSION_TOKEN_REQUIRED=true
API_KEY= # optional shared key for protected routes (not used by default)

# === Misc ===
MAX_REQUEST_TOKENS=8192
TRACK_TOKENS=true
EXTERNAL_TIMEOUT=12
APP_NAME=finance-chatbot-api
AGENT_DEBUG=0

# === MCP (optional World Bank tool) ===
MCP_ENABLE=false
MCP_PROXY_ENABLE=false
MCP_PROXY_ENDPOINT=http://127.0.0.1:8077/mcp

# === Admin ===
ADMIN_KEY= # set to protect /api/admin/rag/reindex

